rules_version = '2';

// EduLearn — teacher website + admin website (student app rules come later).
// Teacher pages: Dashboard … Gradebook, Students, Analytics, Attendance,
// Rewards, Messages, Reports, Settings.
// Teachers only ever see documents stamped with their own uid (teacherId).
// Admins (Auth custom claim role == 'admin', set only by Cloud Functions)
// can read school-wide and manage class assignments, rosters and settings.
// Class codes, accounts and request decisions go through callable
// functions, never direct writes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function uid() { return request.auth.uid; }
    function isMine(data) { return signedIn() && data.teacherId == uid(); }
    function ownsClass(classId) {
      return classId is string &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == uid();
    }
    function ownsStudent(studentId) {
      return studentId is string &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == uid();
    }
    // A teacher's class comment (students' comments come from the student app).
    function validTeacherComment(d) {
      return d.authorId == uid()
        && d.authorRole == 'teacher'
        && d.authorName is string && d.authorName.size() <= 120
        && d.body is string && d.body.size() <= 2000
        && (d.body.size() > 0 || d.get('attachment', null) != null)
        && d.createdAt == request.time;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------- teachers
    match /teachers/{teacherId} {
      allow read: if (signedIn() && uid() == teacherId) || isAdmin();
      allow create: if signedIn() && uid() == teacherId
        && request.resource.data.role == 'teacher';
      // Settings › Profile.
      allow update: if signedIn() && uid() == teacherId
        && onlyChanges(['displayName', 'photoUrl', 'fcmTokens', 'updatedAt',
                        'titleName', 'subject', 'gradeLevels', 'bio'])
        && validProfile(request.resource.data);

      function validProfile(d) {
        return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
          && d.get('titleName', '') is string && d.get('titleName', '').size() <= 40
          && d.get('subject', '') is string && d.get('subject', '').size() <= 60
          && d.get('gradeLevels', []) is list && d.get('gradeLevels', []).size() <= 12
          && d.get('bio', '') is string && d.get('bio', '').size() <= 200;
      }

      match /notifications/{id} {
        allow read, delete: if signedIn() && uid() == teacherId;
        allow update: if signedIn() && uid() == teacherId && onlyChanges(['read']);
      }

      // Settings › preferences (defaults for classwork, grading, notices).
      match /settings/{docId} {
        allow read: if signedIn() && uid() == teacherId;
        allow write: if signedIn() && uid() == teacherId && docId == 'preferences'
          && request.resource.data.notify is map
          && request.resource.data.passingGrade is int
          && request.resource.data.passingGrade >= 0 && request.resource.data.passingGrade <= 100
          && request.resource.data.activityPoints is int && request.resource.data.bossPoints is int
          && request.resource.data.calculation in ['totalPoints', 'weighted', 'none'];
      }
    }

    // ------------------------------------------------------------------ admins
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // setAdminRole function
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.schoolName.size() <= 120;
    }

    // One doc per official code keeps codes unique (createClass function).
    match /classCodes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----------------------------------------------------------------- classes
    // Created only by the createClass / approveClassRequest functions.
    match /classes/{classId} {
      allow read: if isMine(resource.data) || isAdmin();
      allow create, delete: if false;
      // Admin: reassign teacher, rename, archive. (Code: regenerateClassCode.)
      allow update: if isAdmin()
        && onlyChanges(['teacherId', 'section', 'subject', 'gradeLevel', 'status', 'archivedAt'])
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId))
        && request.resource.data.gradeLevel is int
        && request.resource.data.gradeLevel >= 1 && request.resource.data.gradeLevel <= 12
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.section.size() <= 60
        && request.resource.data.status in ['active', 'archived'];
      // Teacher: archive / restore, Edit class details and Class settings.
      // (Grade, section and the class code are official — admin only.)
      allow update: if isMine(resource.data)
        && onlyChanges(['status', 'archivedAt', 'subject', 'coverImageUrl', 'room', 'description',
                        'streamPermission', 'classworkNotifications', 'totalPoints', 'showOverallGrade'])
        && validTeacherClassEdit(request.resource.data);

      function validTeacherClassEdit(d) {
        return d.status in ['active', 'archived']
          && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 80
          && d.get('room', '') is string && d.get('room', '').size() <= 60
          && d.get('description', '') is string && d.get('description', '').size() <= 1000
          && d.get('streamPermission', 'postAndComment') in ['postAndComment', 'commentOnly', 'teachersOnly']
          && d.get('classworkNotifications', 'condensed') in ['details', 'condensed', 'hidden']
          && d.get('totalPoints', 20) is int
          && d.get('totalPoints', 20) >= 1 && d.get('totalPoints', 20) <= 1000
          && d.get('showOverallGrade', true) is bool;
      }

      match /dailyPerformance/{day} {
        allow read: if ownsClass(classId) || isAdmin();
        allow write: if false;
      }
      // Gradebook settings, grading scale, hidden columns, private notes.
      match /gradebook/{docId} {
        allow read: if ownsClass(classId) || isAdmin();
        allow write: if ownsClass(classId)
          && request.resource.data.calculation in ['totalPoints', 'weighted', 'none']
          && request.resource.data.passingGrade is int
          && request.resource.data.passingGrade >= 0 && request.resource.data.passingGrade <= 100
          && request.resource.data.scale is list && request.resource.data.scale.size() <= 12
          && request.resource.data.notes is map && request.resource.data.notes.size() <= 200;
      }

      // Classwork topics ("Week 1: Mga Rehiyon"), managed by the class's teacher.
      match /topics/{topicId} {
        allow read: if ownsClass(classId) || isAdmin();
        allow create, update: if ownsClass(classId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.position is number;
        allow delete: if ownsClass(classId);
      }
      match /monthlyStats/{month} {
        allow read: if ownsClass(classId) || isAdmin();
        allow write: if false;
      }

      // Rewards › point rules, badges and the reward shop.
      match /rewards/{docId} {
        allow read: if ownsClass(classId) || isAdmin();
        allow write: if ownsClass(classId) && docId == 'settings'
          && request.resource.data.points is map
          && request.resource.data.levelSize is int
          && request.resource.data.levelSize >= 50 && request.resource.data.levelSize <= 5000
          && request.resource.data.badges is list && request.resource.data.badges.size() <= 40
          && request.resource.data.shop is list && request.resource.data.shop.size() <= 40;
      }
    }

    // ---------------------------------------------------------------- students
    // Rosters are managed by admins; the student's teacherId must match the
    // class's teacher so the student shows up on that teacher's dashboard.
    match /students/{studentId} {
      function validStudent(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.studentNumber is string && d.studentNumber.size() <= 20
          && d.gradeLevel is int
          && d.classId is string
          && get(/databases/$(database)/documents/classes/$(d.classId)).data.teacherId == d.teacherId;
      }
      allow read: if isMine(resource.data) || isAdmin();
      allow create, update: if isAdmin() && validStudent(request.resource.data);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------- classwork
    match /classwork/{id} {
      allow read: if isAdmin();
      function validClasswork(d) {
        return d.teacherId == uid()
          && ownsClass(d.classId)
          && d.type in ['lesson', 'quest', 'quiz', 'boss', 'activity', 'material']
          && d.status in ['draft', 'scheduled', 'published', 'closed']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.dueDate is timestamp
          && d.points is int && d.points >= 0 && d.points <= 1000;
      }
      allow read: if isMine(resource.data);
      allow create: if signedIn() && validClasswork(request.resource.data)
        && !('submittedCount' in request.resource.data)
        && !('scoreSum' in request.resource.data)
        && !('scoredCount' in request.resource.data)
        && !('commentCount' in request.resource.data);
      // Counters belong to Cloud Functions.
      allow update: if isMine(resource.data) && validClasswork(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['teacherId', 'submittedCount', 'scoreSum', 'scoredCount', 'commentCount']);
      allow delete: if isMine(resource.data);

      // Quiz / Friday Boss questions WITH the answer key — teacher only.
      // getAfter() so the item and its questions can be saved in one batch.
      match /private/{docId} {
        allow read: if isMine(get(/databases/$(database)/documents/classwork/$(id)).data) || isAdmin();
        allow create, update: if isMine(getAfter(/databases/$(database)/documents/classwork/$(id)).data)
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 200;
        allow delete: if isMine(get(/databases/$(database)/documents/classwork/$(id)).data);
      }

      // Class comments on classwork (Stream → comments panel).
      match /comments/{commentId} {
        function post() { return get(/databases/$(database)/documents/classwork/$(id)).data; }
        allow read: if isMine(post()) || isAdmin();
        allow create: if signedIn() && isMine(post()) && validTeacherComment(request.resource.data);
        allow delete: if isMine(post());
        allow update: if false;
      }
    }

    // ------------------------------------------------------------- submissions
    // Created by the student app; teachers grade and return them.
    match /submissions/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      // Gradebook: a grade for work handed in on paper (or not at all).
      allow create: if signedIn()
        && request.resource.data.teacherId == uid()
        && request.resource.data.source == 'teacher'
        && ownsClass(request.resource.data.classId)
        && ownsStudent(request.resource.data.studentId)
        && request.resource.data.status in ['pending', 'returned']
        && request.resource.data.maxScore is int
        && (request.resource.data.score == null
            || (request.resource.data.score is int
                && request.resource.data.score >= 0
                && request.resource.data.score <= request.resource.data.maxScore))
        && request.resource.data.privateFeedback is string
        && request.resource.data.privateFeedback.size() <= 2000;
      // "Remove submission": the student hands it in again.
      allow delete: if isMine(resource.data);
      allow update: if isMine(resource.data)
        && onlyChanges(['score', 'privateFeedback', 'status', 'returnedAt', 'rubricScores', 'notifyStudent'])
        && request.resource.data.status in ['pending', 'returned']
        && (request.resource.data.score == null
            || (request.resource.data.score is int
                && request.resource.data.score >= 0
                && request.resource.data.score <= resource.data.maxScore))
        && request.resource.data.privateFeedback is string
        && request.resource.data.privateFeedback.size() <= 2000;
    }

    // ----------------------------------------------------------- announcements
    // Calendar → Add event ("Faculty Meeting", field trips, reminders).
    match /calendarEvents/{id} {
      function validEvent(d) {
        return d.teacherId == uid()
          && (d.classId == null || ownsClass(d.classId))
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.start is timestamp
          && (d.end == null || d.end is timestamp)
          && d.allDay is bool
          && d.kind in ['school', 'classEvent', 'reminder']
          && d.get('location', '') is string && d.get('location', '').size() <= 120
          && d.get('notes', '') is string && d.get('notes', '').size() <= 1000;
      }
      allow read: if isMine(resource.data) || isAdmin();
      allow create: if signedIn() && validEvent(request.resource.data);
      allow update: if isMine(resource.data) && validEvent(request.resource.data);
      allow delete: if isMine(resource.data);
    }

    // Stream posts. status: published | scheduled (publishAt) | draft.
    // commentCount belongs to Cloud Functions.
    match /announcements/{id} {
      allow read: if isAdmin();
      function validAnnouncement(d) {
        return d.teacherId == uid()
          && (d.classId == null || ownsClass(d.classId))
          && d.title is string && d.title.size() <= 200
          && d.body is string && d.body.size() <= 8000
          && d.pinned is bool
          && d.get('status', 'published') in ['published', 'scheduled', 'draft']
          && (d.get('status', 'published') != 'scheduled' || d.get('publishAt', null) is timestamp)
          && d.get('attachments', []) is list && d.get('attachments', []).size() <= 10
          && (d.title.size() > 0 || d.body.size() > 0 || d.get('attachments', []).size() > 0);
      }
      allow read: if isMine(resource.data);
      allow create: if signedIn() && validAnnouncement(request.resource.data)
        && !('commentCount' in request.resource.data);
      allow update: if isMine(resource.data) && validAnnouncement(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherId', 'commentCount']);
      allow delete: if isMine(resource.data);

      match /comments/{commentId} {
        function post() { return get(/databases/$(database)/documents/announcements/$(id)).data; }
        allow read: if isMine(post()) || isAdmin();
        allow create: if signedIn() && isMine(post()) && validTeacherComment(request.resource.data);
        allow delete: if isMine(post());
        allow update: if false;
      }
    }

    // --------------------------------------------- function-owned read models
    match /activity/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow write: if false;
    }
    match /missingWork/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------- attendance
    // marks: studentId -> present | late | absent | excused
    match /attendance/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.teacherId == uid()
        && ownsClass(request.resource.data.classId)
        && request.resource.data.date is timestamp
        && request.resource.data.marks is map
        && request.resource.data.marks.size() <= 200
        && request.resource.data.get('notes', {}) is map
        && request.resource.data.get('times', {}) is map;
      allow delete: if false;
    }

    // ------------------------------------------------------------- rewards
    // Points the teacher gives by hand (and manual badges).
    match /pointAwards/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.teacherId == uid()
        && ownsClass(request.resource.data.classId)
        && request.resource.data.studentId is string
        && request.resource.data.points is int
        && request.resource.data.points >= -1000 && request.resource.data.points <= 1000
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 120
        && (request.resource.data.badgeId == null || request.resource.data.badgeId is string)
        && request.resource.data.createdAt == request.time;
      allow delete: if isMine(resource.data);
      allow update: if false;
    }

    // Created by the student app; the teacher approves or declines.
    match /rewardRequests/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow update: if isMine(resource.data)
        && resource.data.status == 'pending'
        && onlyChanges(['status', 'decidedAt'])
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.decidedAt == request.time;
      allow create, delete: if false;
    }

    // ------------------------------------------------------------ messages
    // Chats with one student (dm_{teacherId}_{studentId}) or a whole class
    // (class_{classId}). Student messages come from the student app.
    match /conversations/{id} {
      function validConversation(d) {
        return d.teacherId == uid()
          && ownsClass(d.classId)
          && d.kind in ['student', 'group']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && (d.kind == 'group' || ownsStudent(d.studentId))
          && d.unread == 0;
      }
      // A missing conversation may be checked for (Message → start a chat).
      allow get: if resource == null || isMine(resource.data) || isAdmin();
      allow list: if isMine(resource.data) || isAdmin();
      allow create: if signedIn() && validConversation(request.resource.data);
      // The teacher can only lower the unread count (opening the chat).
      allow update: if isMine(resource.data)
        && onlyChanges(['lastMessage', 'lastMessageAt', 'lastRole', 'lastAuthor', 'unread',
                        'studentsCanReply', 'quietHours'])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.unread is int
        && request.resource.data.unread >= 0 && request.resource.data.unread <= resource.data.unread
        && request.resource.data.studentsCanReply is bool
        && request.resource.data.quietHours is bool;
      allow delete: if false;

      match /messages/{messageId} {
        function convo() { return get(/databases/$(database)/documents/conversations/$(id)).data; }
        allow read: if isMine(convo()) || isAdmin();
        allow create: if signedIn() && isMine(convo())
          && request.resource.data.authorId == uid()
          && request.resource.data.authorRole == 'teacher'
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 120
          && request.resource.data.body is string && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // --------------------------------------------------------------- reminders
    // Queued by the teacher, delivered by the deliverReminder function.
    match /reminders/{id} {
      allow read: if isMine(resource.data);
      allow create: if signedIn()
        && request.resource.data.teacherId == uid()
        && ownsStudent(request.resource.data.studentId)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    // ----------------------------------------------------------- classRequests
    // Approve / decline happen in functions (they also notify the teacher).
    match /classRequests/{id} {
      allow read: if isMine(resource.data) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.teacherId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.gradeLevel is int
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.section.size() <= 60;
      allow update, delete: if false;
    }
  }
}
